# ============================================
# WIN AI — API Keys (fill these in)
# ============================================

# 1. BallDontLie API (free at balldontlie.io)
BALLDONTLIE_KEY=XXXXX

# 2. Anthropic API (get at console.anthropic.com)
ANTHROPIC_KEY=XXXXX

# 3. The Odds API (free tier at the-odds-api.com)
ODDS_API_KEY=XXXXX

# 4. RapidAPI key for Tank01 lineups (rapidapi.com — free tier)
RAPIDAPI_KEY=XXXXX

# 5. Admin token — gates write access to the private Scouting Notes admin
# panel (/admin.html). Pick any long random string; share it only between
# you and your cofounder, never commit the real value.
ADMIN_TOKEN=XXXXX

# Server port (leave as 3001)
PORT=3001

# ── Accounts, sign-in and email (see DEPLOY_TO_RAILWAY.md) ──
# Your own site address, no trailing slash. Links in emails are built from this.
PUBLIC_URL=
# Sends the confirmation and password-reset emails (resend.com). MAIL_FROM is an address on a domain you verified there.
RESEND_API_KEY=
MAIL_FROM=
# Email confirmation. Set to off to skip it: people sign up and are in straight away, and no confirmation email is sent.
# Leave it unset (on) once emails can reach anyone, which needs a verified sending domain at Resend.
EMAIL_CONFIRMATION=
# Your own email: props saved before accounts existed move to this account the first time it signs in.
ADMIN_EMAIL=
# Sign in with Google (Google Cloud Console > Credentials > OAuth client ID > Web application).
# Authorized redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LOCAL TESTING ONLY: shows confirmation and reset links on screen instead of emailing them. Never set on a public site.
# AUTH_DEV_LINKS=1

# ── Payments (Stripe) ──
# Leave PAYWALL unset to give everyone full access. PAYWALL=on only takes effect once the three Stripe values below are all set.
# PAYWALL=lock blurs everything for free visitors with no Stripe and no checkout (Pro is given from the admin Users tab).
PAYWALL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ── Offsite backups (any S3-compatible bucket: Cloudflare R2, Backblaze B2, AWS S3) ──
# A copy of the database is encrypted on the server (with BACKUP_PASSPHRASE) and uploaded every night, then restore-tested weekly.
# Keep the passphrase somewhere other than this server too. Without it the copies cannot be opened.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
BACKUP_PASSPHRASE=
# Optional: BACKUP_S3_REGION (default auto) and BACKUP_S3_PREFIX (default winai/)

# ── Errors and uptime alerts ──
# ADMIN_ALERT_WEBHOOK: a Discord or Slack incoming-webhook URL. Errors, failed jobs and data problems are sent there (one message per problem).
# HEARTBEAT_URL: an https address from a service like Healthchecks.io. The app calls it every 5 minutes; if the site goes down the calls stop and that service emails or texts you.
ADMIN_ALERT_WEBHOOK=
HEARTBEAT_URL=

# ── Admin protection ──
# Second factor for the admin page: a 6-digit code from an authenticator app, in addition to ADMIN_TOKEN.
# Make the secret with: node scripts/make-admin-2fa.js   (then add the secret to your authenticator app too)
ADMIN_TOTP_SECRET=

# ── Hosting ──
# Set to 1 on Railway so each visitor is rate-limited separately.
TRUST_PROXY=

# ── Optional tuning: every line below has a working default, so leave it out unless you want to change it ──
# Odds credits (the admin Health page uses these). WARN and CRIT are credits left; SCAN_COST is what a full-slate scan is assumed to cost.
# ODDS_CREDIT_WARN=100
# ODDS_CREDIT_CRIT=40
# ODDS_SCAN_COST=60
# ODDS_ALLOW_LOW_CREDITS=1    # run scans and top-ups even when credits are low (by default a scan waits until ODDS_SCAN_COST credits are left, and top-ups stop at the critical line)
# MAX_SLATE_EVENTS=15         # games scanned each morning
# SLATE_FILL_WINDOW_HOURS=8   # how close to tip-off a game still gets topped up if props are missing
# SLATE_EVAL_CONCURRENCY=3    # props worked out at once during a scan
# Analyses: per day, per account (FREE_DAILY_ANALYSES / PRO_DAILY_ANALYSES), and for the whole site (ANALYZE_DAILY_CAP).
# FREE_DAILY_ANALYSES=1
# PRO_DAILY_ANALYSES=100
# ANALYZE_DAILY_CAP=400
# USER_MAX_PROPS=300          # saved props allowed per account
# BLOCKED_EMAIL_DOMAINS=      # comma-separated sign-up domains to refuse, in addition to the built-in list
# Where things live and what time it is
# WINAI_DB=                   # path of the database file (use a persistent volume when deployed); default: winai.db next to server.js
# APP_TIMEZONE=America/New_York   # the app's day (picks, daily reset, "today") follows this zone
# BRIDGE_CONCURRENCY=2        # stat lookups against nba.com running at once
# ENRICH_BUDGET_MS=800        # how long a page waits for its optional extras before showing what it has
# STRIPE_PRICE_ID_YEARLY=     # a second, yearly price shown next to the monthly one
# STRIPE_AUTOMATIC_TAX=1      # let Stripe work out sales tax at checkout (needs tax set up in Stripe)
