# ============================================
# WIN AI — API Keys (fill these in)
# ============================================

# 1. BallDontLie API (free at balldontlie.io)
BALLDONTLIE_KEY=XXXXX

# 2. Anthropic API (get at console.anthropic.com)
ANTHROPIC_KEY=XXXXX

# 3. The Odds API (free tier at the-odds-api.com)
ODDS_API_KEY=XXXXX

# 4. RapidAPI key for Tank01 lineups (rapidapi.com — free tier)
RAPIDAPI_KEY=XXXXX

# 5. Admin token — gates write access to the private Scouting Notes admin
# panel (/admin.html). Pick any long random string; share it only between
# you and your cofounder, never commit the real value.
ADMIN_TOKEN=XXXXX

# Server port (leave as 3001)
PORT=3001

# ── Accounts, sign-in and email (see DEPLOY_TO_RAILWAY.md) ──
# Your own site address, no trailing slash. Links in emails are built from this.
PUBLIC_URL=
# Sends the confirmation and password-reset emails (resend.com). MAIL_FROM is an address on a domain you verified there.
RESEND_API_KEY=
MAIL_FROM=
# Your own email: props saved before accounts existed move to this account the first time it signs in.
ADMIN_EMAIL=
# Sign in with Google (Google Cloud Console > Credentials > OAuth client ID > Web application).
# Authorized redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LOCAL TESTING ONLY: shows confirmation and reset links on screen instead of emailing them. Never set on a public site.
# AUTH_DEV_LINKS=1

# ── Paywall ──
# PAYWALL unset: everyone has everything.
# PAYWALL=fake: the beta's fake door. Pro features (analyzer, Prop List, line movement, team breakdowns) are locked;
#   Subscribe charges nothing, records the intent in PostHog, and unlocks Pro on that account for good. Needs no Stripe.
# PAYWALL=on: real Stripe subscriptions. Only takes effect once the three Stripe values below are all set.
PAYWALL=
# Price shown on the fake-door pricing screen, e.g. $9.99 / month (nothing is ever charged).
BETA_PRICE_LABEL=
# Free analyses per day. Defaults to 0 with PAYWALL=fake (analyzer is Pro-only) and 1 with PAYWALL=on.
# FREE_DAILY_ANALYSES=

# ── Analytics (PostHog) ──
# Project API key (starts with phc_, public by design) and the project's host (https://us.i.posthog.com or
# https://eu.i.posthog.com). Leave the key empty to send nothing. Events carry the account id only, never the email.
POSTHOG_KEY=
POSTHOG_HOST=

# ── Payments (Stripe, PAYWALL=on only) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ── Hosting ──
# Set to 1 on Railway so each visitor is rate-limited separately.
TRUST_PROXY=
# Where the SQLite database (accounts, saved props) lives. Point it into a mounted Railway volume, e.g.
# /data/winai.db, or every redeploy wipes all accounts. Defaults to winai.db next to server.js.
WINAI_DB=
