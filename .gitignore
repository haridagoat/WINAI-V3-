node_modules/
.env
.env.*
!.env.example
.DS_Store
__pycache__/
*.pyc

# Regenerated by fetch_stats.py / fetch_wnba_stats.py / shotchart.py —
# not source, and committing them just creates merge noise on every run.
*.json
!package.json
!package-lock.json
!railway.json

# Last season's final NBA stat files. They never change, and fetch_stats.py blends the current season with them, so they ship
# with the code (a fresh deploy has no stat files of its own). Each October: copy season_raw/*.json into prior_season/ and commit.
!prior_season/
!prior_season/*.json

# SQLite database, its backups, and the one-time import copy
*.db
*.db-wal
*.db-shm
backups/
*.pre-sqlite.bak
